<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERC Asset Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ERC_Asset_Management_System.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.3/css/dataTables.dataTables.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <style>
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
            margin: 0;
        }

        main {
            flex: 1;
        }

        /* Sidebar styles */
        /* #sidebar {
            width: 250px;
            transition: margin-left 0.3s;
            margin-left: 0; /* visible by default
            background-color: #1f3297;
        } */
        #sidebar {
            width: 250px;
            min-height: 100vh;
            background-color: #1f3297;
            transition: margin-left 0.3s, background-color 0.3s;
            margin-left: 0; /* visible by default */
            color: #fff;
            padding: 1rem;
        }
        #sidebar.collapsed {
            margin-left: -250px; /* hidden */
        }
            /* Sidebar header */
            #sidebar h5 {
                font-size: 1.2rem;
                margin-bottom: 1rem;
                font-weight: bold;
                letter-spacing: 1px;
                border-bottom: 1px solid rgba(255,255,255,0.2);
                padding-bottom: 0.5rem;
                text-transform: uppercase;
            }

            /* Sidebar nav */
            #sidebar .nav {
                padding-left: 0;
                margin-top: 0.5rem;
            }

            /* Sidebar links */
            #sidebar .nav-link {
                color: #e0e0e0;
                padding: 10px 15px;
                border-radius: 8px;
                margin: 5px 0;
                transition: background 0.2s, color 0.2s;
                display: flex;
                align-items: center;
                font-size: 0.95rem;
            }

                /* Hover effect */
                #sidebar .nav-link:hover {
                    background-color: rgba(255, 255, 255, 0.1);
                    color: #ffffff;
                    text-decoration: none;
                }

                /* Active link */
                #sidebar .nav-link.active {
                    background-color: #263fc9;
                    color: #fff;
                    font-weight: bold;
                }

        body.no-transition .sidebar-collapse,
        body.no-transition .sidebar-open {
            transition: none !important;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 no-transition">
    <header>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow"
             style="background-color: #263fc9;" data-bs-theme="dark">
            <div class="container-fluid">
                <!-- Sidebar Toggle Button -->
                <button class="btn btn-outline-light me-2" id="sidebarToggle">
                    ☰
                </button>

                <a class="navbar-brand text-white d-flex align-items-center" href="#">
                    <img src="~/images/ERC-LOGO.png" class="rounded-circle me-2" alt="Logo" style="width: 50px; height: 50px;">
                    <strong>ERC Asset Management System</strong>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Assets" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" href="https://www.erc.gov.ph/privacy" target="_blank" rel="noopener noreferrer">
                                Privacy
                            </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Wrapper for Sidebar + Content -->
    <div class="d-flex flex-grow-1" id="wrapper">
        <!-- Sidebar -->
        <div id="sidebar" class="text-light p-3">
            <h5 class="text-center">Menu</h5>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link text-light active" asp-controller="Dashboard" asp-action="Dashboard">🏠 Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" asp-controller="Assets" asp-action="Index">📦 Assets</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="#">👤 Users</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-light" href="#">⚙ Settings</a>
                </li>
            </ul>
        </div>

        <!-- Main Content -->
        <div id="page-content" class="flex-grow-1 d-flex flex-column">
            <main role="main" class="container container-md pb-3 flex-grow-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Footer sticks to bottom -->
    <footer id="contact" class="text-light py-4 mt-auto" style="background-color: #182465">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <p class="mb-2 mb-md-0">&copy; Energy Regulatory Commission 2025</p>
            <div>
                <a href="https://erc.gov.ph/privacy" class="text-light me-3 text-decoration-none">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/2.3.3/js/dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Toggle Sidebar using class
        document.getElementById("sidebarToggle").addEventListener("click", function () {
            document.getElementById("sidebar").classList.toggle("collapsed");
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let currentPath = window.location.pathname.toLowerCase();

            // remove active from all links first
            document.querySelectorAll("#sidebar .nav-link").forEach(link => {
                link.classList.remove("active");

                let linkPath = link.getAttribute("href");
                if (linkPath && currentPath === linkPath.toLowerCase()) {
                    link.classList.add("active");
                }
            });
        });
    </script>
</body>
</html>
